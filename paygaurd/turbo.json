{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "JWT_SECRET", "NEXT_PUBLIC_API_URL", "EXPRESS_API_URL"],
  "tasks": {
    "build": {
  "dependsOn": ["^db:generate", "^build"],
  "inputs": ["$TURBO_DEFAULT$", ".env*"],
  "outputs": [
    "dist/**",
    ".next/**",
    "!.next/cache/**",
    "!.next/dev/**",
    "generated/**"
  ]
},
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": { 
      "cache": false
    }, 
    "db:migrate": { 
      "cache": false
    }, 
    "db:deploy": { 
      "cache": false
    } 
  }
}
