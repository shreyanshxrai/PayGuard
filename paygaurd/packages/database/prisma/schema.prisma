// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique
  name                 String
  password             String
  flags                Int                  @default(0)
  phone                String
  balance              Int
  sentTransactions     TransactionHistory[] @relation("SentTransactions")
  receivedTransactions TransactionHistory[] @relation("ReceivedTransactions")
}

model TransactionHistory {
  id         Int      @id @default(autoincrement())
  time       DateTime @default(now())
  amount     Int
  fromUserId Int
  toUserId   Int
  Payee      User     @relation("ReceivedTransactions", fields: [toUserId], references: [id])
  Payer      User     @relation("SentTransactions", fields: [fromUserId], references: [id])
}
